# The app runs at https://www.belikelocal.club in development, its API socket at
# wss://api.belikelocal.club/ws — nginx (docker-lemp nginx/conf.d/) terminates
# TLS with the development certificate. Requires
# `127.0.0.1 www.belikelocal.club api.belikelocal.club admin.belikelocal.club`
# in /etc/hosts.
VITE_API_BASE_URL=https://api.belikelocal.club
